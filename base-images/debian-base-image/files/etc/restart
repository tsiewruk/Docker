#!/bin/bash
#
# Restart s6 service
# Usage: /etc/restart <service_name> [timeout_seconds]
#

set -euo pipefail

# Try to load framework logging, fallback to basic echo
if [[ -f /usr/local/lib/entrypoint-common.sh ]]; then
    # shellcheck disable=SC1091
    source /usr/local/lib/entrypoint-common.sh
    ENTRYPOINT_SERVICE_NAME="s6-manager"
    _init_logging 2>/dev/null || true
else
    # Fallback logging functions
    log_info() { echo "[INFO] $*"; }
    log_success() { echo "[SUCCESS] $*"; }
    log_error() { echo "[ERROR] $*" >&2; }
    log_warning() { echo "[WARNING] $*" >&2; }
    log_debug() { echo "[DEBUG] $*"; }
fi

# Validate arguments
if [[ -z "${1:-}" ]]; then
    log_error "Missing service name"
    log_info "Usage: $0 <service_name> [timeout_seconds]"
    exit 1
fi

SERVICE="$1"
TIMEOUT="${2:-10}"  # Default 10 seconds timeout

# Validate service name (alphanumeric, dash, underscore only)
if [[ ! "${SERVICE}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    log_error "Invalid service name: ${SERVICE}"
    log_info "Service name must contain only letters, numbers, dash, and underscore"
    exit 1
fi

# Validate timeout
if [[ ! "${TIMEOUT}" =~ ^[0-9]+$ ]]; then
    log_error "Invalid timeout: ${TIMEOUT}"
    log_info "Timeout must be a positive integer"
    exit 1
fi

SERVICE_PATH="/service/${SERVICE}"

# Check if service directory exists
if [[ ! -d "${SERVICE_PATH}" ]]; then
    log_error "Service not found: ${SERVICE}"
    log_info "Service directory does not exist: ${SERVICE_PATH}"
    exit 1
fi

log_info "Restarting service: ${SERVICE} (timeout: ${TIMEOUT}s)"

# ============================================================================
# STEP 1: Stop the service
# ============================================================================

log_debug "Sending stop signal to ${SERVICE}..."

if s6-svstat "${SERVICE_PATH}" 2>/dev/null | grep -q '^down'; then
    log_info "Service ${SERVICE} is already stopped"
else
    # Send graceful stop signal
    if ! s6-svc -d "${SERVICE_PATH}"; then
        log_error "Failed to send stop signal to service: ${SERVICE}"
        exit 1
    fi

    # Wait for service to stop (with timeout)
    local elapsed=0
    local stop_timeout=$((TIMEOUT / 2))  # Use half timeout for stop
    log_debug "Waiting for service to stop (timeout: ${stop_timeout}s)..."

    while (( elapsed < stop_timeout )); do
        if s6-svstat "${SERVICE_PATH}" 2>/dev/null | grep -q '^down'; then
            log_success "Service ${SERVICE} stopped gracefully"
            break
        fi
        sleep 1
        ((elapsed++))
    done

    # Check if service stopped
    if ! s6-svstat "${SERVICE_PATH}" 2>/dev/null | grep -q '^down'; then
        log_warning "Service ${SERVICE} did not stop gracefully, sending kill signal..."
        if ! s6-svc -k "${SERVICE_PATH}"; then
            log_error "Failed to kill service: ${SERVICE}"
            exit 1
        fi
        sleep 2

        # Final check
        if ! s6-svstat "${SERVICE_PATH}" 2>/dev/null | grep -q '^down'; then
            log_error "Service ${SERVICE} could not be stopped"
            exit 1
        fi
        log_warning "Service ${SERVICE} forcefully stopped"
    fi
fi

# ============================================================================
# STEP 2: Start the service
# ============================================================================

log_debug "Sending start signal to ${SERVICE}..."

if ! s6-svc -u "${SERVICE_PATH}"; then
    log_error "Failed to send start signal to service: ${SERVICE}"
    exit 1
fi

# Wait for service to start (with timeout)
local elapsed=0
local start_timeout=$((TIMEOUT / 2))  # Use half timeout for start
log_debug "Waiting for service to start (timeout: ${start_timeout}s)..."

while (( elapsed < start_timeout )); do
    if s6-svstat "${SERVICE_PATH}" 2>/dev/null | grep -q '^up'; then
        log_success "Service ${SERVICE} started successfully"
        break
    fi
    sleep 1
    ((elapsed++))
done

# ============================================================================
# STEP 3: Verify restart
# ============================================================================

if s6-svstat "${SERVICE_PATH}" 2>/dev/null | grep -q '^up'; then
    log_success "Service ${SERVICE} restarted successfully"

    # Display service info
    if status_output=$(s6-svstat "${SERVICE_PATH}" 2>/dev/null); then
        log_info "Service status: ${status_output}"

        # Try to extract PID
        if pid=$(echo "${status_output}" | grep -oP 'pid \K[0-9]+' 2>/dev/null); then
            log_info "New PID: ${pid}"
        fi
    fi

    exit 0
else
    log_error "Service ${SERVICE} failed to restart"
    log_info "Service is not running after restart attempt"

    # Show last few log lines if available
    if [[ -d "${SERVICE_PATH}/log" ]] && [[ -r "${SERVICE_PATH}/log/current" ]]; then
        log_info "Last log entries:"
        tail -n 5 "${SERVICE_PATH}/log/current" 2>/dev/null || true
    fi

    exit 1
fi
